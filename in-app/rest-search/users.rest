@baseUrl = http://localhost:3000/users
@id = 5adfc398-79e5-4526-a178-551202321a39
@idRemove = 9148ac71-281a-434b-9a57-90cf76d075cc

@token = Bearer {{login.response.body.accessToken}}
@newToken = Bearer {{refresh.response.body.accessToken}}


@refreshToken = Bearer {{login.response.body.refreshToken}}


### LOGIN
# @name login
POST http://localhost:3000/auth/signIn
Content-Type: application/json

{
    "email": "william@hotmail.com",
    "password": "1234"
}

###
# @name refresh
POST http://localhost:3000/auth/refresh-token
Authorization: {{refreshToken}}


### GET ME
GET {{baseUrl}}/me
Authorization: {{newToken}}


### UPDATE ME
PATCH  {{baseUrl}}/me
Authorization: {{token}}
Content-Type: application/json

{
    "name": "william Italia"
}


### UPDATE MY PASSWORD
PATCH  {{baseUrl}}/me/password
Authorization: {{token}}
Content-Type: application/json

{
    "currentPassword": "1234",
    "newPassword": "pass",
    "confirmNewPassword": "pass"
}

### DELETE ME
DELETE {{baseUrl}}/me
Authorization: {{token}}



### List Users
GET {{baseUrl}}/users

### Find One User
GET {{baseUrl}}/users/{{id}}

### Create User
POST {{baseUrl}}/users/
Content-Type: application/json

{
    "email": "williamitalia31@hotmail.com",
    "name": "william",
    "password": "12345",
    "passwordConfirm": "12345" 1
}

### Update User
PATCH  {{baseUrl}}/users/{{id}}
Content-Type: application/json

{
    "email": "robson1@example.com",
    "name": "robson silva"
}

### Remove User
DELETE {{baseUrl}}/users/{{idRemove}}

